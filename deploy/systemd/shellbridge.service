[Unit]
Description=ShellBridge MCP service
Documentation=https://github.com/fengyincheng/ShellBridge
After=network.target
ConditionPathExists=/sys/fs/cgroup/cgroup.controllers

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/shellbridge
EnvironmentFile=/etc/shellbridge/shellbridge.env
UMask=0077
ExecStartPre=/usr/bin/install -d -o root -g root -m 0700 /var/lib/shellbridge
ExecStart=/usr/bin/env node /opt/shellbridge/dist/src/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
