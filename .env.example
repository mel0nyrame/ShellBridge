# Required: yes | Secret: yes | Default: none | Format: opaque string | Restart: yes
# Security: administrator REST credential; keep only in a root-owned 0600 environment file.
SHELLBRIDGE_BEARER_TOKEN=

# Required: yes | Secret: yes | Default: none | Format: base64-encoded 32 bytes | Restart: yes
# Security: seals proposals; changing it makes existing sealed proposals unreadable.
SHELLBRIDGE_DATA_KEY=

# Required: yes | Secret: yes | Default: none | Format: opaque string | Restart: yes
# Security: authenticates the single owner's OAuth consent; use a value independent of the Bearer token.
SHELLBRIDGE_OAUTH_OWNER_SECRET=

# Required: remote deployments yes, local development no | Secret: no
# Default: http://127.0.0.1:8765 | Format: absolute HTTP(S) URL without query, fragment, or trailing slash | Restart: yes
# Security: defines the OAuth issuer, MCP resource, metadata endpoints, and OpenAPI server; use HTTPS remotely.
SHELLBRIDGE_PUBLIC_BASE_URL=https://shellbridge.example.com

# Required: no | Secret: no | Default: 8765 | Format: integer from 1 to 65535 | Restart: yes
# Security: changes only the loopback port; the listen host remains fixed at 127.0.0.1.
SHELLBRIDGE_PORT=8765

# Required: no | Secret: no (contents are sensitive) | Default: /var/lib/shellbridge/shellbridge.db
# Format: absolute or working-directory-relative file path | Restart: yes
# Security: proposal/OAuth trust-root database; parent directory must be root-owned and not exposed to the sandbox.
SHELLBRIDGE_DATABASE_PATH=/var/lib/shellbridge/shellbridge.db

# Required: no | Secret: no | Default: /root | Format: directory path | Restart: yes
# Security: default diagnostic cwd; it must be within a configured sandbox read root.
SHELLBRIDGE_DEFAULT_CWD=/root

# Required: no | Secret: no | Default: /root | Format: directory path | Restart: yes
# Security: hard boundary for document, local Git, project-task, and existing-script paths.
SHELLBRIDGE_OPERATION_ROOT=/root

# Required: no | Secret: no | Default: /root | Format: colon-separated directory paths | Restart: yes
# Security: host trees visible read-only to generic diagnostics; review every entry and its blocked descendants.
SHELLBRIDGE_SANDBOX_READ_ROOTS=/root

# Required: no | Secret: no (paths may reveal topology) | Default: empty
# Format: colon-separated exact file paths | Restart: yes
# Security: only listed files can be read by inspect_config, and only through selector/redaction policy.
SHELLBRIDGE_INSPECT_CONFIG_TARGETS=

# Required: no | Secret: no (paths may reveal topology) | Default: empty
# Format: colon-separated directory paths | Restart: yes
# Security: roots from which the native helper may open registered inspect_config targets.
SHELLBRIDGE_INSPECT_CONFIG_ROOTS=

# Required: no | Secret: must not contain secrets | Default: {} | Format: JSON object, no delimiter | Restart: yes
# Security: allowlist of cleartext values by absolute target and selector; credentials remain status-only.
SHELLBRIDGE_INSPECT_CONFIG_DISCLOSURES={}

# Required: no | Secret: no (paths may reveal topology) | Default: empty plus built-in deny rules
# Format: colon-separated exact file/directory paths | Restart: yes
# Security: adds resources that diagnostics and persistent capabilities must never access.
SHELLBRIDGE_BLOCKED_PATHS=

# Required: no | Secret: no | Default: chatgpt.com,chat.openai.com
# Format: comma-separated hostnames | Restart: yes
# Security: limits dynamic OAuth client redirect URI hosts; do not add broad or untrusted domains.
SHELLBRIDGE_OAUTH_REDIRECT_HOSTS=chatgpt.com,chat.openai.com

# Required: no | Secret: no | Default: dist/native/shellbridge-helper | Format: executable path | Restart: yes
# Security: trusted native boundary for safe host reads and seccomp generation; deploy only the reviewed build.
SHELLBRIDGE_NATIVE_HELPER_PATH=dist/native/shellbridge-helper

# Required: no | Secret: no | Default: dist/native/network-deny.bpf | Format: file path | Restart: yes
# Security: trusted seccomp filter consumed by the sandbox; keep it root-owned and generated by the native helper.
SHELLBRIDGE_SECCOMP_FILTER_PATH=dist/native/network-deny.bpf

# Required: no | Secret: no | Default: /usr/bin/bwrap | Format: executable path | Restart: yes
# Security: trusted sandbox constructor; pointing to another executable changes the isolation boundary.
SHELLBRIDGE_BWRAP_PATH=/usr/bin/bwrap

# Required: no | Secret: no | Default: /sys/fs/cgroup/shellbridge | Format: cgroup v2 directory path | Restart: yes
# Security: root under which per-command CPU, memory, and process limits are enforced.
SHELLBRIDGE_CGROUP_ROOT=/sys/fs/cgroup/shellbridge

# Required: no | Secret: no | Default: false | Format: true/false/1/0 | Restart: yes
# Security: total local kill switch for every persistent execution; keep false unless writes are intentionally enabled.
SHELLBRIDGE_WRITE_ACTIONS_ENABLED=false

# Required: no | Secret: no | Default: false | Format: true/false/1/0 | Restart: yes
# Security: capability switch for Markdown/TXT document changes; also requires the total switch.
SHELLBRIDGE_DOCUMENT_WRITES_ENABLED=false

# Required: no | Secret: no | Default: false | Format: true/false/1/0 | Restart: yes
# Security: capability switch for local Git index and commit changes; also requires the total switch.
SHELLBRIDGE_LOCAL_GIT_WRITES_ENABLED=false

# Required: no | Secret: no | Default: false | Format: true/false/1/0 | Restart: yes
# Security: capability switch for frozen pre-existing scripts; also requires the total switch.
SHELLBRIDGE_EXISTING_SCRIPT_RUNS_ENABLED=false
